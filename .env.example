# Camera RTSP URL (H.264). Read by go2rtc, never by the web app.
STREAM_URL=rtsp://user:password@camera.lan:554/stream
# Numeric code of the Weathercloud station (the digits in app.weathercloud.net/d<code>).
WEATHERCLOUD_DEVICE=0000000000
# LAN address go2rtc advertises for WebRTC (host IP + published 8555). Unset: MSE only.
WEBRTC_CANDIDATE=host.lan:8555
